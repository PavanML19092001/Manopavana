rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'manopavana@gmail.com' ||
        request.auth.token.email == 'pavanml19092001@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{testDoc} {
      allow read: if true;
    }

    // Customer profile & persistent cart
    match /customers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Customer reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.rating is number;
      allow update, delete: if isAdmin();
    }

    // Store CMS configuration & dynamic pricing
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
